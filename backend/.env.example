# Copy to backend/.env for local development, or set these as environment
# variables in your host (Render dashboard / render.yaml).
# Never commit the filled-in .env file.

# --- required in every deployment ------------------------------------------

# MongoDB Atlas connection string.
# Atlas > Network Access must allow 0.0.0.0/0 for Render's dynamic outbound IPs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ceyharvest_db?retryWrites=true&w=majority
MONGODB_DATABASE=ceyharvest_db

# JWT signing key - MUST be at least 32 characters (HS256 requirement).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS. Patterns are supported,
# e.g. https://*.vercel.app for preview deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the frontend, used for links in password-reset emails.
FRONTEND_URL=http://localhost:5173

# --- safety ----------------------------------------------------------------

# Registers /api/dev/** and /api/admin/reset/** with NO authentication.
# These seed and reset live data - keep false in anything deployed.
DEV_ENDPOINTS_ENABLED=false

# --- optional integrations -------------------------------------------------

# Gmail SMTP. Use a Google App Password, not the account password.
# Leave blank to disable outbound email.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Stripe. Leave blank to keep PaymentService in mock mode.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# External Flask yield model (see /ml-api). Leave blank to use the built-in
# estimator - the Flask app is not currently deployable as-is.
ML_API_URL=

# Port to bind on. Render injects this automatically; ignore locally.
# PORT=8080
